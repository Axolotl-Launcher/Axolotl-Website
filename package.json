{
  "name": "@axolotl/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-search-index.ts && tsx scripts/fetch-launcher-demo.ts && nuxt dev",
    "build": "tsx scripts/build-search-index.ts && tsx scripts/fetch-launcher-demo.ts && nuxt build && tsx scripts/check-media.ts",
    "check:media": "tsx scripts/check-media.ts",
    "check:ts": "tsx scripts/check-typescript.ts",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "tsx scripts/check-typescript.ts && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --config playwright.config.ts",
    "test:e2e:ci": "playwright test --config playwright.config.ts --grep-invert @visual",
    "test:e2e:update": "pnpm build && playwright test --config playwright.config.ts --update-snapshots",
    "check-agents": "tsx scripts/check-agents.ts",
    "prepr": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check": "ultracite check"
  },
  "dependencies": {
    "@comark/vue": "0.9.2",
    "@fontsource-variable/inter": "5.3.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "comark": "0.9.2",
    "dayjs": "^1.11.23",
    "lenis": "^1.3.27",
    "minisearch": "^7.2.0",
    "motion-v": "^2.12.0",
    "nuxt": "4.6.4",
    "nuxt-icons": "4.0.0",
    "nuxt-lenis": "^3.0.0",
    "nuxt-studio": "1.8.2",
    "shiki": "4.6.0",
    "swiper": "^14.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tippy.js": "^6.3.7",
    "verkit": "^0.5.0",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "1.2.154",
    "@nuxt/devtools": "4.1.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@takumi-rs/core": "^2.20.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "better-sqlite3": "13.1.1",
    "debug": "4.4.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "extend": "3.0.2",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "parse5": "8.1.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-raw": "7.0.0",
    "remark-emoji": "5.0.2",
    "remark-gfm": "4.0.1",
    "remark-mdc": "3.11.1",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "ultracite": "8.2.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vite-plugin-inspect": "^12.1.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.18.0"
  }
}

{
  "name": "@axolotl/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-launcher-demo.mjs && nuxt dev",
    "build": "node scripts/fetch-launcher-demo.mjs && nuxt generate && node scripts/check-media.mjs",
    "generate": "node scripts/fetch-launcher-demo.mjs && nuxt generate && node scripts/check-media.mjs",
    "check:media": "node scripts/check-media.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --config playwright.config.ts",
    "test:e2e:ci": "playwright test --config playwright.config.ts --grep-invert @visual",
    "test:e2e:update": "pnpm build && playwright test --config playwright.config.ts --update-snapshots",
    "feishu:sync": "tsx scripts/feishu/sync.ts",
    "feishu:sync:dry": "tsx scripts/feishu/sync.ts --dry-run",
    "feishu:validate": "tsx scripts/feishu-validate.ts",
    "check-agents": "node scripts/check-agents.mjs",
    "prepr": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "nuxt": "4.6.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.154",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@nuxt/devtools": "4.1.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.1.0",
    "better-sqlite3": "13.1.1",
    "eslint": "10.14.0",
    "github-slugger": "2.0.0",
    "p-limit": "7.3.3",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plugin-inspect": "^12.1.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.18.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./app/assets/css/main.css",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2
  }
}

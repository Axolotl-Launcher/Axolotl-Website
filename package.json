{
  "name": "@axolotl/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build-blog-index.ts && tsx scripts/build-search-index.ts && tsx scripts/fetch-launcher-demo.ts && nuxt dev",
    "build": "tsx scripts/build-blog-index.ts && tsx scripts/build-search-index.ts && tsx scripts/fetch-launcher-demo.ts && nuxt generate && tsx scripts/check-media.ts",
    "generate": "tsx scripts/build-blog-index.ts && tsx scripts/build-search-index.ts && tsx scripts/fetch-launcher-demo.ts && nuxt generate && tsx scripts/check-media.ts",
    "check:media": "tsx scripts/check-media.ts",
    "check:ts": "tsx scripts/check-typescript.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "tsx scripts/check-typescript.ts && eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --config playwright.config.ts",
    "test:e2e:ci": "playwright test --config playwright.config.ts --grep-invert @visual",
    "test:e2e:update": "pnpm build && playwright test --config playwright.config.ts --update-snapshots",
    "check-agents": "tsx scripts/check-agents.ts",
    "prepr": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@comark/vue": "0.9.2",
    "@fontsource-variable/inter": "5.3.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxtjs/device": "4.0.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "6.0.1",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "dayjs": "^1.11.23",
    "lenis": "^1.3.27",
    "minisearch": "^7.2.0",
    "motion-v": "^2.12.0",
    "nuxt": "4.6.4",
    "nuxt-icons": "4.0.0",
    "nuxt-lenis": "^3.0.0",
    "shiki": "4.6.0",
    "swiper": "^14.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tippy.js": "^6.3.7",
    "verkit": "^0.5.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.154",
    "@nuxt/devtools": "4.1.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@takumi-rs/core": "^2.20.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "better-sqlite3": "13.1.1",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plugin-inspect": "^12.1.0",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.18.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./app/assets/css/main.css",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2
  }
}

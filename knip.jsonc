{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["content.config.ts", "e2e/**/*.ts", "scripts/**/*.ts"],
  "ignoreFiles": ["app/components/BaseTabs.vue"],
  "ignoreDependencies": [
    "@eslint/js",
    "@iconify-json/lucide",
    "@takumi-rs/core",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "debug",
    "eslint-config-prettier",
    "eslint-plugin-compat",
    "eslint-plugin-github",
    "eslint-plugin-html",
    "eslint-plugin-jsdoc",
    "eslint-plugin-n",
    "eslint-plugin-promise",
    "eslint-plugin-sonarjs",
    "eslint-plugin-unicorn",
    "eslint-plugin-unused-imports",
    "eslint-plugin-vue",
    "eslint-plugin-vuejs-accessibility",
    "extend",
    "globals",
    "parse5",
    "rehype-raw",
    "remark-emoji",
    "remark-gfm",
    "remark-mdc",
    "remark-rehype",
    "sharp",
    "unified",
    "unist-util-visit",
    "vue-qrcode-reader",
    "vue-tsc",
  ],
}

# dependencies
node_modules

# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist
.vite
.turbo

# Deployment tool state
.wrangler/
.vercel/
.netlify

# Environment files
.env
.env.*
!.env.example

# The launcher's web demo build, put there by scripts/fetch-launcher-demo.mjs
/public/launcher-demo/

# Generated by scripts/build-search-index.mjs before dev/build.
/public/search-index.json
# The contributors card, put there by scripts/generate-contributors.ts
/public/contributors.svg

# Generated by @modrinth/tooling-config
packages/tooling-config/script-utils/import-sort.js

# Vitest failure attachments and visual-regression screenshots
.vitest-attachments/
**/__screenshots__/

# Playwright failure artifacts (traces, error contexts, reports)
**/test-results/
**/playwright-report/

# Agent intermediate and archived artifacts (plans, specs, worklogs, evidence); see REVIEW.md.
/.agents/plans/

# Local agent/scratch caches; keep maintained instructions and Skills tracked.
/.agents/tmp/
/.agents/cache/

# IDEs, editors and system files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Legacy Nuxt 3 tree; the site lives in app/. Guard against merge residue.
/src/

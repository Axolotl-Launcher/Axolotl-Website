# Nuxt Studio production OAuth (GitHub).
# Create the OAuth App with callback https://axlmc.org/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account emails allowed to publish. CI reads this from
# the repository variable `NUXT_STUDIO_AUTH_GITHUB_MODERATORS`.
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
# Long random value used to encrypt the Studio session cookie.
NUXT_STUDIO_AUTH_SESSION_SECRET=
# Optional PAT for non-OAuth auth providers or local GitHub commits.
NUXT_STUDIO_GIT_GITHUB_TOKEN=

# Optional Afdian validation for the support checkout API.
NUXT_AFDIAN_USER_ID=
NUXT_AFDIAN_TOKEN=

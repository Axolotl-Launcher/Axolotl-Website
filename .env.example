# Feishu tenant custom app. Grant docx:document:readonly, wiki:wiki:readonly
# and drive:drive:readonly (or docs:document.media:download), then add the app
# to the knowledge base space.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional overrides for Lark international or a custom tenant origin.
FEISHU_API_BASE=https://open.feishu.cn
FEISHU_WEB_BASE=

# Optional Afdian Open API credentials. When present, the support checkout
# endpoint validates plan IDs with Afdian's query-plan API. Keep these
# server-side only; never expose them through runtimeConfig.public.
NUXT_AFDIAN_USER_ID=
NUXT_AFDIAN_TOKEN=

# Public search-only Algolia configuration for the /search page. The search
# key is exposed to the browser by design; the page renders its first results
# during prerendering (SSR) and continues client-side after hydration.
NUXT_PUBLIC_ALGOLIA_APP_ID=
NUXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NUXT_PUBLIC_ALGOLIA_INDEX_NAME=
